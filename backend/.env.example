# App environment: dev | prod
APP_ENV=dev

FRONTEND_URL=http://localhost:3000
VOYAGE_API_KEY=

# Database (local: docker-compose postgres, prod: Neon)
DATABASE_URL=postgresql://nori:nori@localhost:5432/nori

# Clerk webhook secret (from Clerk dashboard -> Webhooks)
# CLERK_WEBHOOK_SECRET=whsec_...

# Chroma local (used when APP_ENV=dev)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Chroma Cloud (used when APP_ENV=prod)
# CHROMA_CLOUD_API_KEY=
# CHROMA_CLOUD_TENANT=
# CHROMA_CLOUD_DATABASE=